---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import { getContent } from "@/lib/getContent";

const introDefault =
  "Giuliano\nDesenvolvedor de Software & Sistemas Embarcados\n\nTransformo ideias e desafios em soluções tecnológicas eficientes, com foco em desenvolvimento de software, sistemas embarcados e aplicações web.\n\nDesenvolvimento • Tecnologia • Inovação";
---

<section>
  <Wrapper variant="standard" class="pb-8 pt-40 lg:pt-80">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start gap-y-8">
      <Text
        tag="h1"
        variant="displayMD"
        class="mx-auto max-w-5xl whitespace-pre-line font-semibold leading-snug text-left tracking-tighter text-base-900 dark:text-white lg:col-span-4"
        data-editable="intro.text"
      >
        {getContent("intro.text", introDefault)}
      </Text>
    </div>
  </Wrapper>
</section>
